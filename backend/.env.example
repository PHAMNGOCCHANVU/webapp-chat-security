# ============================================================
# .env.example — Secure Internal Chat Backend
# Sao chép file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env lên git
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# NODE_ENV options: development | production | test

# ── Database (SQL Server) ────────────────────────────────────
DATABASE_URL=sqlserver://localhost:1433;database=ZelegramDB;user=sa;password=YourStrongPassword123;trustServerCertificate=true

# ── Session ──────────────────────────────────────────────────
# QUAN TRỌNG: chuỗi ngẫu nhiên tối thiểu 32 ký tự
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars

# ── CORS (Allowed Origins) ────────────────────────────────────
# Danh sách origins được phép, phân cách bởi dấu phẩy (không có dấu cách)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
