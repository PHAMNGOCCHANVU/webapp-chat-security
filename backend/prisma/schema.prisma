generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ========================================
// USERS - Bảng người dùng
// ========================================
model User {
  id           String @id @default(uuid())
  username     String @unique
  email        String @unique
  passwordHash String @map("password_hash")
  displayName  String @map("display_name")
  avatarUrl    String? @map("avatar_url")
  status       String @default("ACTIVE")
  // status: ACTIVE | LOCKED | DISABLED | DELETED

  userRoles          UserRole[]
  createdMessages    Message[]
  auditLogs          AuditLog[]
  sessions           Session[]
  friendRequestsSent     FriendRequest[] @relation("sender")
  friendRequestsReceived FriendRequest[] @relation("receiver")
  friendships1       Friendship[] @relation("user1")
  friendships2       Friendship[] @relation("user2")
  conversationMembers ConversationMember[] @relation("conversationMembers")
  createdConversations Conversation[] @relation("createdBy")

  bio          String? @db.NVarChar(500)
  phone        String? @db.NVarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("users")
}

// ========================================
// ROLES - Bảng vai trò
// ========================================
model Role {
  id          String @id @default(uuid())
  roleName    String @unique @map("role_name")
  description String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// ========================================
// PERMISSIONS - Bảng quyền
// ========================================
model Permission {
  id          String @id @default(uuid())
  permissionName String @unique @map("permission_name")
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ========================================
// USER ROLES - Bảng gán vai trò cho người dùng
// ========================================
model UserRole {
  userId    String
  roleId    String
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ========================================
// ROLE PERMISSIONS - Bảng gán quyền cho vai trò
// ========================================
model RolePermission {
  roleId       String
  permissionId String

  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ========================================
// FRIEND REQUESTS - Bảng yêu cầu kết bạn
// ========================================
model FriendRequest {
  id         String @id @default(uuid())
  senderId   String @map("sender_id")
  receiverId String @map("receiver_id")
  message    String? @db.NVarChar(500)
  status     String @default("PENDING")
  // status: PENDING | ACCEPTED | REJECTED

  sender     User @relation("sender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver   User @relation("receiver", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt  DateTime @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@map("friend_requests")
}

// ========================================
// FRIENDSHIPS - Bảng liên hệ bạn bè
// ========================================
model Friendship {
  id       String @id @default(uuid())
  user1Id  String @map("user1_id")
  user2Id  String @map("user2_id")

  user1    User @relation("user1", fields: [user1Id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user2    User @relation("user2", fields: [user2Id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("friendships")
}

// ========================================
// CONVERSATIONS - Bảng cuộc hội thoại (Rooms)
// ========================================
model Conversation {
  id               String @id @default(uuid())
  conversationType String @map("conversation_type")
  // conversationType: PRIVATE | GROUP
  conversationName String? @map("conversation_name")
  status           String @default("ACTIVE")
  // status: ACTIVE | ARCHIVED | DELETED
  createdBy        String @map("created_by")
  directMessageKey String? @unique @map("direct_message_key")
  lastMessageId    String? @map("last_message_id")
  lastMessageAt    DateTime? @map("last_message_at")

  creator              User @relation("createdBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members              ConversationMember[]
  messages             Message[] @relation("ConversationMessages")
  lastMessage          Message? @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationType, updatedAt])
  @@index([createdBy])
  @@index([lastMessageAt])
  @@map("conversations")
}

// ========================================
// CONVERSATION MEMBERS - Bảng thành viên cuộc hội thoại
// ========================================
model ConversationMember {
  conversationId String @map("conversation_id")
  userId         String @map("user_id")
  memberRole     String @default("MEMBER") @map("member_role")
  // memberRole: OWNER | MEMBER
  lastReadAt     DateTime? @map("last_read_at")
  unreadCount    Int @default(0) @map("unread_count")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User @relation("conversationMembers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
  @@map("conversation_members")
}

// ========================================
// MESSAGES - Bảng tin nhắn
// ========================================
model Message {
  id              String @id @default(uuid())
  conversationId  String @map("conversation_id")
  senderId        String @map("sender_id")
  encryptedContent Bytes? @map("encrypted_content")
  imageUrl        String? @map("image_url")
  isDeleted       Boolean @default(false) @map("is_deleted")

  conversation Conversation @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: NoAction)
  sender       User @relation(fields: [senderId], references: [id], onDelete: NoAction)
  lastMessageFor Conversation[] @relation("ConversationLastMessage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ========================================
// AUDIT LOGS - Bảng nhật ký kiểm toán
// ========================================
model AuditLog {
  id           String @id @default(uuid())
  actorUserId  String? @map("actor_user_id")
  actionType   String @map("action_type")
  moduleName   String? @map("module_name")
  targetTable  String? @map("target_table")
  targetId     String? @map("target_id")
  actionStatus String @map("action_status")
  // actionStatus: SUCCESS | FAILED
  ipAddress    String? @map("ip_address")
  userAgent    String? @map("user_agent") @db.NVarChar(1000)
  description  String? @map("description") @db.NVarChar(Max)

  actor User? @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ========================================
// SESSION - Bảng lưu trữ phiên (express-session)
// ========================================
model Session {
  id        String @id @default(uuid())
  sid       String @unique
  data      String @db.NVarChar(Max)
  expiresAt DateTime @map("expires_at")
  userId    String?
  
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}
