generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─── Người dùng ───
// role: "USER" | "ADMIN"
// status: "ACTIVE" | "LOCKED"
model User {
  id           String @id @default(cuid())
  username     String @unique
  displayName  String
  email        String @unique
  passwordHash String
  role         String @default("USER")
  status       String @default("ACTIVE")

  messages    Message[]
  memberships RoomMember[]
  auditLogs   AuditLog[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Session lưu trong DB (session-based auth) ───
model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String   @db.NVarChar(Max)
  expiresAt DateTime
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Phòng chat ───
model Room {
  id        String  @id @default(cuid())
  name      String
  isPrivate Boolean @default(false)
  isDirect  Boolean @default(false)

  members  RoomMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Thành viên phòng chat ───
model RoomMember {
  id      String  @id @default(cuid())
  roomId  String
  userId  String
  isOwner Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roomId, userId])
}

// ─── Tin nhắn ───
model Message {
  id       String @id @default(cuid())
  content  String @db.NVarChar(Max)
  roomId   String
  senderId String

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Nhật ký thao tác nhạy cảm ───
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String   // VD: "LOGIN", "REGISTER", "DELETE_MESSAGE", "CHANGE_ROLE"...
  targetType  String?  // VD: "User", "Room", "Message"
  targetId    String?
  description String?  @db.NVarChar(Max)
  metadata    String?  @db.NVarChar(Max) // JSON bổ sung
  ipAddress   String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
