    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.7.4",
