PORT=3000
NODE_ENV=development

# SQL Server connection string
# Please update <YourPassword> to your actual SQL Server password.
DATABASE_URL=sqlserver://localhost:1433;database=ZelegramDB;user=sa;password=<YourPassword>;trustServerCertificate=true

# Session secret — generate using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_32_character_string_here

# Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:5501,http://localhost:5500,http://localhost:5501,http://localhost:5173,http://127.0.0.1:5173
