PORT=4000
NODE_ENV=development

# SQL Server connection string
DATABASE_URL=sqlserver://localhost:1433;database=ZalegramDB;user=sa;password=<YourPassword>;trustServerCertificate=true

# Must be exactly 64 hex characters
ENCRYPTION_KEY=replace_with_64_hex_characters

# Use long random secrets and do not reuse them
SESSION_SECRET=replace_with_a_long_random_secret
JWT_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
